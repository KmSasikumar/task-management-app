# Prisma database connection string
# For local dev: postgresql://user:password@localhost:5432/taskdb
# For production: provided by Render PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/taskdb"

# Frontend URL for CORS (your Vercel deployment URL)
# For local dev: not needed (defaults to localhost:3000)
# For production: https://your-app.vercel.app
FRONTEND_URL=
