datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String
  avatar    String?
  title     String?
  username  String?
  initials  String?

  tasksReported Task[] @relation("TaskReporter")
  tasksAssigned Task[] @relation("TaskMembers")

  projectsLed Project[] @relation("ProjectLead")
  projectsAssigned Project[] @relation("ProjectMembers")

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  priority  String   // urgent, high, medium, low, none
  dueDate   DateTime?

  leadId    String
  lead      User     @relation("ProjectLead", fields: [leadId], references: [id])

  members   User[]   @relation("ProjectMembers")

  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   // todo, doing, completed, on-hold, backlog
  priority    String   // urgent, high, medium, low, none
  dueDate     DateTime?
  labels      String?  // comma-separated

  reporterId  String?
  reporter    User?    @relation("TaskReporter", fields: [reporterId], references: [id])

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  members     User[]   @relation("TaskMembers")

  subtasks    Subtask[]
  comments    Comment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  priority  String
  dueDate   DateTime?
  status    String

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
